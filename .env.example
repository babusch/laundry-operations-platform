# Local development defaults only. Never put production credentials here.
POSTGRES_DB=laundry
POSTGRES_USER=laundry
POSTGRES_PASSWORD=laundry_local_dev_only
POSTGRES_PORT=15432

# Separate plant gateway database; does not share cloud data.
PLANT_POSTGRES_DB=laundry_plant
PLANT_POSTGRES_USER=laundry_edge
PLANT_POSTGRES_PASSWORD=laundry_edge_local_dev_only
PLANT_POSTGRES_PORT=15433

# Optional local identity stack. Generate distinct development-only values.
IDENTITY_DB_PASSWORD=
IDENTITY_ADMIN_PASSWORD=
GATEWAY_CLIENT_SECRET=
