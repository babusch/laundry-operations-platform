{
  "realm": "laundry-development",
  "displayName": "Laundry Operations Development",
  "enabled": true,
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "scans.ingest",
        "description": "Allows a registered gateway to deliver scan observations to the cloud API"
      }
    ]
  },
  "scopeMappings": [
    {
      "client": "gateway-development",
      "roles": [
        "scans.ingest"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "laundry-cloud-api",
      "name": "Laundry cloud API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "gateway-development",
      "name": "Development gateway",
      "description": "Disposable local identity for the synthetic development plant only",
      "enabled": true,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${GATEWAY_CLIENT_SECRET}",
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {
          "name": "cloud-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "laundry-cloud-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "registered-tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "11111111-1111-4111-8111-111111111111",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "registered-plant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "plant_id",
            "claim.value": "22222222-2222-4222-8222-222222222222",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "application-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "laundry_permissions",
            "claim.value": "scans.ingest",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-gateway-development",
      "enabled": true,
      "serviceAccountClientId": "gateway-development",
      "realmRoles": [
        "scans.ingest"
      ]
    }
  ]
}
